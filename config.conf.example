# immich-auto-dumper — configuration
# Copy this file to config.conf and fill in the values,
# or use: immich-auto-dumper setup
#
# This file is READ, not executed. A value is taken exactly as written: no command
# substitution, no variable expansion, no shell syntax of any kind. Surrounding
# quotes are optional and simply stripped. The two exceptions, substituted as
# plain text in path settings, are a leading "~/" and a leading "$HOME/".
# Any setting not listed below is rejected by name, as is a value the setting
# cannot hold — the tool refuses to run rather than act on half a configuration.

# --- Immich ---
IMMICH_UPLOAD_LOCATION="/path/to/immich/upload"  # Host path to UPLOAD_LOCATION
IMMICH_DB_LIBRARY_PREFIX="/data/library"         # Absolute prefix of "originalPath" in the DB.
                                                 # Auto-detected by setup: /data/library on current
                                                 # Immich images, /usr/src/app/upload/library on
                                                 # older ones — which is also the last-resort value
                                                 # when nothing can be detected.
IMMICH_DB_CONTAINER="immich_postgres"
IMMICH_SERVER_CONTAINER="immich_server"
IMMICH_DB_NAME="immich"
IMMICH_DB_USER="postgres"

# --- External storage ---
# Host path of the external storage, mounted inside the immich_server container.
ARCHIVE_DEST_PATH="/mnt/external"
# Same path as seen from the Docker container.
ARCHIVE_CONTAINER_PATH="/external_library"
# Storage identity marker. Generated by "setup" and written both here and to
# $ARCHIVE_DEST_PATH/.immich-auto-dumper.id on the storage itself. Used to verify
# the storage is actually reachable (any type: local, OS mount, rclone/NFS, etc.)
# before writing. Leave empty; setup fills it in.
ARCHIVE_STORAGE_ID=""
# DB backups will be placed in : $ARCHIVE_DEST_PATH/.immich-backup/
# Archived photos will be in   : $ARCHIVE_DEST_PATH/<FolderName>/...

# --- Archive boundaries (library size, in MiB; 1 GiB = 1024 MiB) ---
# Driven by the actual size of UPLOAD_LOCATION/library (not whole-disk usage).
# `setup` accepts GB, MB or a percentage of the disk (e.g. 200, 1.5G, 500M, 80%)
# and stores the result here in MiB, so fractional-GB limits are possible.
# (The older ARCHIVE_LIBRARY_MAX_GB / ARCHIVE_LIBRARY_TARGET_GB keys are still
#  honored for backward compatibility if the *_MB keys are absent.)
ARCHIVE_LIBRARY_MAX_MB=204800      # archiving starts when library/ exceeds this (=200 GiB)
ARCHIVE_LIBRARY_TARGET_MB=153600   # archiving runs until library/ drops to this (=150 GiB)

# Also archive (down to TARGET) if total free disk space on this filesystem drops
# below this, regardless of library size — a safety net against other processes
# (Postgres, Docker, logs...) filling the disk before the library ever hits MAX.
# `setup` computes a recommended default from the disk size; 0 disables it.
ARCHIVE_MIN_FREE_MB=10240           # e.g. 10 GiB

# --- DB backup ---
# How many Immich database dumps to keep in $ARCHIVE_DEST_PATH/.immich-backup/.
# Independent of Immich's own backup.database.keepLastAmount, which only governs the
# dumps Immich keeps locally in $IMMICH_UPLOAD_LOCATION/backups (the matching 14
# defaults are a coincidence). `setup` reads Immich's value and suggests it, so the
# mirror never drops a dump Immich still holds; keeping fewer than Immich does means
# the oldest exist in one place only.
BACKUP_RETENTION=14                # Number of dumps kept on the external storage

# --- User → external folder mapping ---
# One line per user, generated automatically by "setup"; can be edited manually.
# The part after "USER_MAP." is the key: storageLabel, or the user's UUID when
# storageLabel is empty. The value is a folder inside the external library, and
# two users must never be given the same one.
# USER_MAP.alice=Alice
# USER_MAP.bob=Bob
#
# Configs written by earlier versions carry `declare -A USER_MAP` followed by
# USER_MAP["alice"]="Alice" lines. Those are still read; setup rewrites them in
# the form above the next time it runs.

# --- Logs ---
# Must be writable by the user running the tool (no sudo). An absolute path, or
# one starting with ~/ — nothing here is expanded by a shell. Defaults to
# $XDG_STATE_HOME/immich-auto-dumper (or ~/.local/state/…) when unset.
LOG_DIR=~/.local/state/immich-auto-dumper
LOG_MAX_LINES=1000
